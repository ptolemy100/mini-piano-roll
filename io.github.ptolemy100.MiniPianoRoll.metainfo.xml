<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ptolemy100.MiniPianoRoll</id>
  <name>Mini Piano Roll</name>
  <summary>A tiny piano roll music sequencer</summary>
  <developer id="io.github.ptolemy100">
    <name>ptolemy100</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Mini Piano Roll is a small music sequencer with four monophonic parts, chiptune-style sound, and a handful of tuning systems.</p>
    <p>Features:</p>
    <ul>
      <li>Four independent parts and quick subdivision modes, including triplets and quintuplets</li>
      <li>Equal temperament, well temperament, Ptolemaic and harmonic series tunings</li>
      <li>Real-time and pre-rendered playback</li>
      <li>Export to WAV, PNG and MP4 video</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.ptolemy100.MiniPianoRoll.desktop</launchable>
